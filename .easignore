# .easignore — controls what is uploaded to EAS Build.
#
# IMPORTANT: when this file exists, EAS Build uses it INSTEAD of .gitignore.
# Anything that must stay out of the upload has to be listed here, even if
# .gitignore already covers it.
#
# Everything below is either regenerated on the build server or is local-only
# output. Nothing here is required to build Android, iOS, or OTA updates.

# ---- dependencies (reinstalled from package-lock.json on the builder) ----
node_modules/

# ---- version control / editor state ----
.git/
.cursor/
.aider*

# ---- Expo, Metro and TypeScript caches (regenerated) ----
.expo/
.metro-health-check*
*.tsbuildinfo
expo-env.d.ts

# ---- web / desktop build output (not an input to a native build) ----
dist/
web-build/
release/
build/
coverage/

# ---- native build artifacts ----
# Regenerated by Gradle, CMake and CocoaPods during every EAS build. These are
# the directories that previously inflated the archive to ~600 MB.
android/app/build/
android/app/.cxx/
android/build/
android/.gradle/
android/local.properties
ios/build/
ios/Pods/
ios/DerivedData/

# ---- separate macOS Xcode project ----
# eas.json targets the `ios/` project (scheme "HealthAge"); mac-ios/ is a
# standalone Mac Catalyst project and is not used by any EAS build profile.
mac-ios/

# ---- compiled app binaries sitting in the repo root ----
# Build outputs from earlier local/EAS runs. ~75 MB.
*.ipa
*.apk
*.aab

# ---- stray files in the repo ROOT only ----
# The leading "/" anchors these to the project root, so assets/files/** is NOT
# affected. The app loads every template from assets/files/ via require(); the
# root copies are unreferenced duplicates (~14 MB of PDFs) and the source
# workbooks used for translation (~1 MB), none of which are build inputs.
# NOTE: assets/files/Health_Age_Table.xlsx IS required by readExcel.ts and is
# deliberately left untouched by these root-anchored patterns.
/*.pdf
/*.xlsx

# ---- signing material and secrets ----
# EAS manages credentials remotely; keystores must never be uploaded.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env*.local

# ---- logs ----
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ---- documentation ----
# Not needed to build. README is kept for context on the builder.
*.md
!README.md
